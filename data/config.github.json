{
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4.1-flash-1017",
    "base_url": "https://a6api.vip/v1",
    "api_key_env": "OPENAI_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["zh", "en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {"threshold": 7.0, "topic_dedup": true},
      "tech-blog": {"threshold": 4.0, "topic_dedup": false},
      "finance-news": {"threshold": 7.0, "topic_dedup": true}
    }
  },
  "sources": {
    "github": [
      {"type": "repo_releases", "owner": "SilyNoMeta", "repo": "rtx-encore", "enabled": true, "profile": "tech-news"}
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {"name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ai", "profile": "tech-news"},
      {"name": "VideoCardz", "url": "https://www.videocardz.com/feed", "enabled": true, "category": "gpu", "profile": "tech-news"},
      {"name": "Cointelegraph", "url": "https://cointelegraph.com/rss", "enabled": true, "category": "crypto", "profile": "finance-news"}
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {"subreddit": "LocalLLaMA", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "profile": "tech-news"},
        {"subreddit": "jailbreak", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "profile": "tech-news"},
        {"subreddit": "nvidia", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 60, "profile": "tech-news"}
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {"enabled": false, "channels": []}
  },
  "collection": {"time_window_hours": 24},
  "digest": {
    "max_items": 30,
    "profile_order": ["tech-news", "tech-blog", "finance-news"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {"enabled": false, "url_env": "HORIZON_WEBHOOK_URL", "delivery": "summary_and_items", "overview_position": "last", "platform": "feishu", "layout": "collapsible", "fallback_layout": "markdown", "languages": ["zh"], "request_body": {}, "headers": ""}
}
